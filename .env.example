# ANTHROPIC_API_KEY: Required for all AI features (Claude).
# Create a key in the Anthropic Console. Do not commit your real key.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# ANTHROPIC_MODEL: Optional. Defaults to claude-haiku-5-5.
ANTHROPIC_MODEL="claude-haiku-5-5"

# Gmail (optional): lets the corporate email agent search and read your inbox.
# Create an OAuth client (Desktop app) in Google Cloud with the Gmail API enabled,
# then get a refresh token for the scope https://www.googleapis.com/auth/gmail.readonly.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# APP_URL: The URL where this app is hosted. Optional when running locally.
APP_URL="MY_APP_URL"
